# Build output
artifacts/

# Debug symbols
*.pdb

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo

# Local settings written by the app. These are per-machine and must never be committed -
# settings.json is preferences, and vault.kvw is the encrypted vault itself.
settings.json
vault.kvw
*.kvw
*.kvw.tmp
*.kvw.bak
crash.log

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Note: assets/ and docs/images/ are intentionally committed. They contain the logo and the
# screenshots used by the README, both generated by the scripts in tools/.
